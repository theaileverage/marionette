{
  "name": "@theaileverage/marionette-effect-port",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.8.1"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "effect:diagnostics": "effect-tsgo diagnostics --project tsconfig.json --format text",
    "effect:diagnostics:json": "effect-tsgo diagnostics --project tsconfig.json --format json --list-files",
    "toolchain:check": "node scripts/diagnostics-smoke.mjs",
    "lint": "oxlint src tests scripts",
    "lint:anti-slop-smoke": "node scripts/anti-slop-smoke.mjs",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "build": "node scripts/build.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "boundaries:check": "node scripts/verify-boundaries.mjs"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/tsgo": "0.43.0",
    "@oxlint/plugins": "1.82.0",
    "@types/node": "24.13.4",
    "esbuild": "0.28.2",
    "oxlint": "1.82.0",
    "typescript": "7.0.2"
  },
  "bin": {
    "marionette": "dist/v1/cli.js",
    "marionette-effect": "dist/v1/cli.js"
  },
  "types": "./dist/v1/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/v1/index.d.ts",
      "import": "./dist/v1/index.js"
    },
    "./herdr-sdk": {
      "types": "./dist/herdr-sdk.d.ts",
      "import": "./dist/herdr-sdk.js"
    },
    "./herdr-protocol": {
      "types": "./dist/herdr-protocol.d.ts",
      "import": "./dist/herdr-protocol.js"
    },
    "./herdr-streams": {
      "types": "./dist/herdr-streams.d.ts",
      "import": "./dist/herdr-streams.js"
    },
    "./herdr-transport": {
      "types": "./dist/herdr-transport.d.ts",
      "import": "./dist/herdr-transport.js"
    },
    "./adapters": {
      "types": "./dist/v1/adapters.d.ts",
      "import": "./dist/v1/adapters.js"
    },
    "./adapters/herdr": {
      "types": "./dist/v1/adapters/herdr.d.ts",
      "import": "./dist/v1/adapters/herdr.js"
    },
    "./adapters/codex-app-server": {
      "types": "./dist/v1/adapters/codex-app-server.d.ts",
      "import": "./dist/v1/adapters/codex-app-server.js"
    }
  },
  "files": [
    "dist/**",
    "workflows/**",
    "skills/**",
    "vendor/herdr-0.9.0/LICENSE",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "docs/diagnostics.md",
    "docs/extensions.md"
  ]
}
