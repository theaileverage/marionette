{
  "name": "@theaileverage/marionette",
  "version": "1.0.0-alpha.1",
  "type": "module",
  "engines": {
    "node": ">=26.8.1"
  },
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "check": "tsc --noEmit -p tsconfig.v1.json && tsc --noEmit -p tsconfig.tests.json && npm run lint",
    "test": "node scripts/test-v1.mjs",
    "format": "prettier --write src/v1 src/herdr-sdk.ts src/herdr-protocol.ts src/herdr-streams.ts src/herdr-transport.ts tests/v1 workflows scripts package.json tsconfig.json tsconfig.v1.json tsconfig.tests.json .github/workflows",
    "format:check": "prettier --check src/v1 src/herdr-sdk.ts src/herdr-protocol.ts src/herdr-streams.ts src/herdr-transport.ts tests/v1 workflows scripts package.json tsconfig.json tsconfig.v1.json tsconfig.tests.json .github/workflows",
    "lint": "oxlint src/v1 src/herdr-sdk.ts src/herdr-streams.ts src/herdr-transport.ts tests/v1 scripts/bundle.mjs scripts/package-smoke-v1.mjs scripts/release.mjs",
    "prepack": "npm run check && npm run test && npm run build",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:check": "node scripts/release.mjs check",
    "sdk:generate": "node scripts/generate-herdr-sdk.mjs"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.82.0",
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "^3.9.6",
    "typescript": "7.0.2"
  },
  "description": "A local, evidence-backed workflow runtime for coding agents.",
  "bin": {
    "marionette": "dist/v1/cli.js"
  },
  "types": "./dist/v1/index.d.ts",
  "files": [
    "dist/v1/**",
    "dist/herdr-sdk.js",
    "dist/herdr-sdk.d.ts",
    "dist/herdr-protocol.js",
    "dist/herdr-protocol.d.ts",
    "dist/herdr-streams.js",
    "dist/herdr-streams.d.ts",
    "dist/herdr-transport.js",
    "dist/herdr-transport.d.ts",
    "workflows/**",
    "skills/**",
    "vendor/herdr-0.9.0/LICENSE",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "documentation/v1/adapters.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theaileverage/marionette.git"
  },
  "homepage": "https://github.com/theaileverage/marionette#readme",
  "bugs": {
    "url": "https://github.com/theaileverage/marionette/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/v1/index.d.ts",
      "import": "./dist/v1/index.js"
    },
    "./herdr-sdk": {
      "types": "./dist/herdr-sdk.d.ts",
      "import": "./dist/herdr-sdk.js"
    },
    "./adapters": {
      "types": "./dist/v1/adapters.d.ts",
      "import": "./dist/v1/adapters.js"
    },
    "./adapters/herdr": {
      "types": "./dist/v1/adapters/herdr.d.ts",
      "import": "./dist/v1/adapters/herdr.js"
    },
    "./adapters/codex-app-server": {
      "types": "./dist/v1/adapters/codex-app-server.d.ts",
      "import": "./dist/v1/adapters/codex-app-server.js"
    }
  },
  "packageManager": "bun@1.3.14"
}
