{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "declaration": true
  },
  "include": [
    "src/v1/**/*.ts",
    "src/herdr-sdk.ts",
    "src/herdr-protocol.ts",
    "src/herdr-streams.ts",
    "src/herdr-transport.ts"
  ]
}
